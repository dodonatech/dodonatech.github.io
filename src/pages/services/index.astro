---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import SectionHead from "../../components/ui/SectionHead.astro";
import Reveal from "../../components/ui/Reveal.astro";
import Icon from "../../components/ui/Icon.astro";
import CTABand from "../../components/sections/CTABand.astro";
import { SERVICES } from "../../lib/content";
---

<BaseLayout
    title="Services"
    description="Seven software engineering practices: AI readiness, modernization, process automation, VR/AR, data, strategy, and delivery."
>
    <PageHero
        eyebrow="Services"
        title="Seven practices. One team."
        lead="We cover the full arc of a technology decision — from strategy and assessment through implementation and handoff.Every engagement is tailored to your goals, project requirements, and budget, with a focus on clear communication and dependable delivery."
        breadcrumbs={[{ label: "Home", href: "/" }, { label: "Services" }]}
    />

    <section class="section-y">
        <div class="container-brand">
            <div class="grid grid--3">
                {
                    SERVICES.map((service, i) => (
                        <Reveal delay={Math.min(i, 3) * 70}>
                            <article class="card">
                                <div class="card__icon">
                                    <Icon name={service.icon} size={22} />
                                </div>
                                <h3 class="h4">{service.title}</h3>
                                <p>{service.blurb}</p>
                                <a
                                    href={`/services/${service.slug}`}
                                    class="card__link"
                                >
                                    Explore{" "}
                                    <Icon name="arrow-right" size={16} />
                                </a>
                            </article>
                        </Reveal>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section-y section-alt">
        <div class="container-brand">
            <Reveal>
                <SectionHead
                    eyebrow="Full capability list"
                    title="Everything we do."
                />
            </Reveal>

            <div>
                {
                    SERVICES.map((service) => (
                        <a
                            href={`/services/${service.slug}`}
                            class="service-row"
                        >
                            <div>
                                <h3>{service.title}</h3>
                                <p>
                                    {service.subServices
                                        .map((s) => s.label)
                                        .join(" · ")}
                                </p>
                            </div>
                            <span class="service-row__arrow">
                                <Icon name="arrow-right" size={20} />
                            </span>
                        </a>
                    ))
                }
            </div>

            <Reveal delay={100} class="mt-10">
                <a href="/book" class="btn btn--primary">
                    Book a discovery call <Icon name="arrow-right" size={16} />
                </a>
            </Reveal>
        </div>
    </section>

    <CTABand />
</BaseLayout>
