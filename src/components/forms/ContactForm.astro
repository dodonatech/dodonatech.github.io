---
import Icon from "../ui/Icon.astro";
import { CONTACT_FORM, CONTACT_EMAIL } from "../../lib/content";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<form
    class="card"
    action="https://api.web3forms.com/submit"
    method="POST"
    data-ajax-form
    data-success-message="Thanks — message received."
>
    <!-- Web3Forms required fields -->
    <input type="hidden" name="access_key" value={accessKey} />
    <input
        type="hidden"
        name="subject"
        value="New Contact Inquiry from Dodona Site"
    />
    <input type="hidden" name="from_name" value="Dodona Website" />

    <div class="form-grid form-grid--2">
        <div class="field">
            <label for="contact-name"
                >Name <span class="req" aria-hidden="true">*</span></label
            >
            <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                placeholder="Jane Doe"
            />
        </div>
        <div class="field">
            <label for="contact-email"
                >Work email <span class="req" aria-hidden="true">*</span></label
            >
            <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="jane@company.com"
            />
        </div>
        <div class="field">
            <label for="contact-company"
                >Company <span class="req" aria-hidden="true">*</span></label
            >
            <input
                id="contact-company"
                name="company"
                type="text"
                autocomplete="organization"
                required
                placeholder="Acme Corp"
            />
        </div>
        <div class="field">
            <label for="contact-phone">Phone</label>
            <input
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder="(214) 555-0123"
            />
        </div>
        <div class="field">
            <label for="contact-interest">What can we help with?</label>
            <select id="contact-interest" name="interest">
                <option value="">Select a practice…</option>
                {
                    CONTACT_FORM.interestOptions.map((opt) => (
                        <option>{opt}</option>
                    ))
                }
            </select>
        </div>
        <div class="field">
            <label for="contact-budget">Budget range</label>
            <select id="contact-budget" name="budget">
                <option value="">Select a range…</option>
                {
                    CONTACT_FORM.budgetOptions.map((opt) => (
                        <option>{opt}</option>
                    ))
                }
            </select>
        </div>
    </div>

    <div class="field mt-6">
        <label for="contact-message"
            >What are you trying to solve? <span class="req" aria-hidden="true"
                >*</span
            ></label
        >
        <textarea
            id="contact-message"
            name="message"
            required
            placeholder="A sentence or two is plenty — current state, the outcome you want, and any hard deadlines."
        ></textarea>
    </div>

    <div class="honeypot" aria-hidden="true">
        <label for="contact-botcheck">Website</label>
        <input
            id="contact-botcheck"
            name="botcheck"
            type="text"
            tabindex="-1"
            autocomplete="off"
        />
    </div>

    <div class="mt-6">
        <button
            type="submit"
            class="btn btn--primary btn--lg w-full"
            data-submit-btn
        >
            Send message <Icon name="arrow-right" size={16} />
        </button>
        <p class="tiny muted mt-3">
            We'll respond within one business day. Your details are never shared
            or sold.
        </p>
    </div>

    <div class="form-success" data-form-success hidden>
        <div class="form-success__icon"><Icon name="check" size={28} /></div>
        <h3 class="h3">Thanks — message received.</h3>
        <p class="muted mt-3">
            An engineer will reply within one business day. If it's
            urgent, email <a class="text-gold" href={`mailto:${CONTACT_EMAIL}`}
                >{CONTACT_EMAIL}</a
            >.
        </p>
    </div>
</form>
