---
import type { IconName } from "../../lib/content";

interface Props {
    name: IconName;
    size?: number;
    class?: string;
}

const { name, size = 20, class: className = "" } = Astro.props;
---

<svg
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    class={className}
>
    <use href={`#i-${name}`}></use>
</svg>
