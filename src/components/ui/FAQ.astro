---
interface Props {
    items: { q: string; a: string }[];
    class?: string;
}
const { items, class: className = "" } = Astro.props;
---

<div class:list={["faq", className]}>
    {
        items.map((item) => (
            <details>
                <summary>{item.q}</summary>
                <div class="faq__answer">{item.a}</div>
            </details>
        ))
    }
</div>
